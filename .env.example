# ── Process Manager: llama.cpp chat (port 8081) ──
# Full command as you would type it in CMD (everything on one line, no ^ line continuations)
# Set LLAMA_CHAT_CMD to empty or comment out to disable
LLAMA_CHAT_CMD=build/bin/Release/llama-server.exe --model models/other/Qwen3.5-9B-UD-Q4_K_XL.gguf --alias qwen9b --ctx-size 10000 --batch-size 2048 -np 2 --ubatch-size 512 --temp 0.7 --presence-penalty 1.5 --top-p 0.8 --top-k 20 --min-p 0.0 --cache-type-k f16 --cache-type-v f16 --cache-ram 0 --n-gpu-layers 41 --no-mmap --no-mmproj --host 0.0.0.0 --port 8081 -lv 3 --chat-template-kwargs "{\"enable_thinking\":false}"
LLAMA_CHAT_WORK_DIR=C:/Users/path/to/llama.cpp
LLAMA_CHAT_HEALTH_URL=http://127.0.0.1:8081/v1/models
LLAMA_CHAT_AUTO_START=true

# ── Process Manager: llama.cpp embeddings (port 8082) ──
LLAMA_EMBED_CMD=build/bin/Release/llama-server.exe --model models/embeddings/Qwen3-4B-Q8_0_em.gguf --embedding --pooling last --batch-size 1024 --ubatch-size 1024 -np 1 --ctx-size 2048 -ngl 99 --cache-ram 0 --port 8082
LLAMA_EMBED_WORK_DIR=C:/Users/path/to/llama.cpp
LLAMA_EMBED_HEALTH_URL=http://127.0.0.1:8082/v1/models
LLAMA_EMBED_AUTO_START=true

# ── Process Manager: acestep (on-demand only) ──
# Used only when manually triggering the "understand" ingest phase
ACESTEP_CMD=C:/Users/path/to/acestep.cpp/server.cmd
ACESTEP_WORK_DIR=C:/Users/path/to/acestep.cpp
ACESTEP_PORT=8085
ACESTEP_AUTO_START=false
