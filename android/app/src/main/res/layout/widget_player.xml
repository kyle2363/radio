<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/widget_open"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_empty"
            android:textColor="@color/widget_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_empty_hint"
            android:textColor="@color/widget_subtitle"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_previous"
        android:src="@drawable/ic_widget_previous"
        android:tint="@color/widget_title" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:background="@drawable/widget_play_background"
        android:contentDescription="@string/widget_play"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/widget_on_accent" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_next"
        android:src="@drawable/ic_widget_next"
        android:tint="@color/widget_title" />
</LinearLayout>
