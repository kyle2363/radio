<?xml version="1.0" encoding="utf-8"?>
<!-- The pill sits inside the launcher cell with a little clear space above and below, like the system media widgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="6dp">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="6dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- A circle with the same 10dp inset on the top, bottom and left, so it nests in the rounded end. -->
            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp"
                android:adjustViewBounds="true"
                android:background="@drawable/widget_artwork_mask"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                android:maxWidth="56dp"
                android:maxHeight="56dp"
                android:scaleType="fitCenter"
                android:src="@drawable/player_artwork" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_start_radio"
                    android:textColor="@color/widget_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_empty_hint"
                    android:textColor="@color/widget_subtitle"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_transport_background"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_title" />

        <ImageButton
            android:id="@+id/widget_toggle"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/widget_play_background"
            android:contentDescription="@string/widget_play"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_on_accent" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_transport_background"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_title" />
    </LinearLayout>
</FrameLayout>
