<!-- Media-session fallback for songs without cover art: the theme gradient alone. The system enlarges and dims it
     behind the notification and lock-screen controls, where a symbol would sit under the text. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp" android:height="192dp"
    android:viewportWidth="48" android:viewportHeight="48">
    <path android:pathData="M0,0 H48 V48 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="34" android:centerY="11"
                android:gradientRadius="48" android:startColor="#FF4277C3" android:endColor="#FF182D53" />
        </aapt:attr>
    </path>
</vector>
