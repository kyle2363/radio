<!-- Media-session fallback for songs without cover art. The same bitmap fills the small lock-screen circle and the
     enlarged, dimmed notification background, so the note is kept small. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp" android:height="192dp"
    android:viewportWidth="48" android:viewportHeight="48">
    <path android:pathData="M0,0 H48 V48 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="34" android:centerY="11"
                android:gradientRadius="48" android:startColor="#FF4277C3" android:endColor="#FF182D53" />
        </aapt:attr>
    </path>
    <!-- The widget's note (player_artwork) at a little over half size, so it stays recognisable in the lock-screen
         circle without filling the enlarged notification background. -->
    <group android:scaleX="0.55" android:scaleY="0.55" android:pivotX="24" android:pivotY="24" android:translateX="0.4">
        <group android:rotation="-20" android:pivotX="20.5" android:pivotY="31">
            <path android:pathData="M15.5,31 a5,4 0 1,0 10,0 a5,4 0 1,0 -10,0 Z" android:fillColor="#FFF5F9FF" />
        </group>
        <path android:pathData="M23,30.4 L23,12.6 C23,12.1 23.4,11.8 23.9,11.9 C27.5,13 31.8,16.5 31.2,21.5 C30.9,23.5 30.2,25 29.3,26.2 C30.2,22 28.4,19.4 25.4,18.6 L25.4,30.4 Z"
            android:fillColor="#FFF5F9FF" />
    </group>
</vector>
