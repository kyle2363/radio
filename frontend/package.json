{
  "name": "radio",
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.radio.app",
    "productName": "Radio",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis", "icon": "electron/tray-icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!venv/**", "!__pycache__/**", "!*.log"] }
    ]
  }
}
